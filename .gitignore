# Lokale Secrets und Overrides - niemals committen
*.local.yaml
*.local.json
broker/definitions.generated.yaml

# Der geklonte Upstream. Er wird per Commit gepinnt (cf/PINNED), nicht
# mitversioniert: es ist ein fremdes Repo, kein Teil dieses hier.
cf/kind-deployment/

# cf-CLI-Artefakte
.cf/

# Die Kubeconfig aus `make app-access`. Enthält ein ServiceAccount-Token.
access/kubeconfig-*.yaml

# Gebaute Programme der Beispiele. `cf push` braucht sie, das Repo nicht -
# sieben Megabyte, die sich bei jeder Aenderung vollstaendig unterscheiden.
samples/*/dist/

# Die Kubeconfigs der Mandanten aus `make apps-mandant`. Jede traegt ein
# gueltiges Token - sie gehoeren dem Mandanten, nicht dem Repo.
apps/kubeconfig-*.yaml
