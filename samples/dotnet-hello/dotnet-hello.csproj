<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- net8.0, nicht net9.0/net10.0: LTS und damit die Version, die im
       dotnet-core-Buildpack am zuverlaessigsten vorhanden ist. Passt die
       Framework-Version nicht zum Angebot des Buildpacks, bricht das Staging
       mit "no compatible SDK" ab. Notfalls steuerbar ueber
       BP_DOTNET_FRAMEWORK_VERSION. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
