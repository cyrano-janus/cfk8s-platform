# Alle Versionen an EINER Stelle. Wer eine Komponente hebt, ändert sie hier und
# nirgends sonst — die Makefile-Ziele und die Skripte in ops/ lesen von hier.

# ---------------------------------------------------------------- Cloud Foundry
# Das Upstream-Projekt, das die echten CF-Komponenten auf kind ausrollt:
# cloud_controller_ng (capi), UAA, Diego, gorouter, credhub, loggregator.
#
# Gepinnt auf einen Commit, nicht auf einen Branch. Ein Repo, das seine
# BOSH-Release-Versionen laufend nachzieht, ändert sonst unter uns die
# Plattform, gegen die wir Befunde protokollieren.
#
# Und zwar auf einen Commit, der ein **Tag** trägt: c3d6df4 ist v0.24.0. Der
# vorige Pin (ea2c0ad) lag mitten in diesem Release - derselbe Gedanke, halb
# ausgeführt, denn ein loser Commit ist nirgends beschrieben. Zu einem Tag
# gehören Release-Notes, gegen die sich ein Befund datieren lässt.
#
# Der Sprung bringt: k8s-policy-agent 0.4.0 und Calico als Alternative zu
# Cilium. Letzteres ist der Grund für den Sprung - die Ursache von FINDINGS #32
# liegt in Ciliums Prüfung gegen Endpunkt-Identitäten. Die CF-Komponenten
# ändern sich nicht (weiterhin cf-deployment v60.5.0).
CF_KIND_REPO=https://github.com/cloudfoundry/kind-deployment.git
CF_KIND_COMMIT=c3d6df4
KIND_CLUSTER_NAME=cfk8s

# Welche CNI der Upstream installiert. Er liest die Variable aus der Umgebung
# (values.yaml.gotmpl: `cni: {{ "CNI" | env | default "cilium" }}`), und das
# `export` im Makefile reicht alles aus dieser Datei an ihn weiter.
#
# Auf `calico`, weil die Ursache von FINDINGS #32 in Cilium liegt: es prueft
# eine Egress-Regel gegen die Endpunkt-Identitaet des Ziel-Pods, und eine ASG
# kennt nur CIDRs - der Weg einer App zu ihrer Datenbank ist damit durch eine
# ASG nicht zu oeffnen. Calico wertet `nets:` gegen die Zieladresse aus. Ob die
# ASG damit traegt, ist die Messung, fuer die diese Zeile steht.
#
# Zurueck auf `cilium` ist eine Zeile plus `make down cf-up`. Der Upstream
# testet beide.
CNI=calico

# Der Namespace, in dem die CF-Komponenten liegen (vom Upstream vorgegeben).
CF_SYSTEM_NAMESPACE=cf-system

# Org und Space, in denen geprüft wird.
CF_ORG=system
CF_SPACE=spike

# ---------------------------------------------------------------- Broker
BROKER_SRC=../osb-broker-go
BROKER_IMAGE=osb-broker-go:dev
BROKER_NAMESPACE=osb-broker
BROKER_FULLNAME=osb-broker
BROKER_NAME=osb-broker-go

# Welche ServiceDefinitions aus dem Broker-Repo ausgerollt werden. Die Liste
# steuert `make broker-definitions` und beide Richtungen der Katalogprüfung in
# verify/05-broker.sh.
BROKER_DEFINITIONS="cnpg-postgresql cnpg-pgvector rabbitmq-cluster"

# Der Namespace, in dem die Ressourcen der Instanzen liegen (ADR 0010). Muss
# mit config.instanceNamespaceTemplate in broker/values.cfk8s.yaml
# uebereinstimmen - `make instance-namespace` legt ihn an.
INSTANCE_NAMESPACE=osb-instances

# ---------------------------------------------------------------- Backing Services
# Wie ein Operator installiert wird, steht in services/<name>/service.env;
# WELCHE Version, steht hier.
CNPG_VERSION=1.30.0
RABBITMQ_OPERATOR_VERSION=v2.22.5

# ---------------------------------------------------------------- Werkzeuge
CERT_MANAGER_VERSION=v1.19.4
# yq braucht der Upstream fuer den Buildpack-Upload, bringt es aber nicht mit.
YQ_VERSION=v4.47.1

# ---------------------------------------------------------------- Anwendungen
# Mandant für eine Anwendung, die hier ihre eigene Datenbank betreibt - nicht
# über den Broker, sondern direkt am CNPG-Operator. Bewusst NICHT
# INSTANCE_NAMESPACE: was dort liegt, gehört dem Broker, und eine fremde
# Datenbank darin sähe in einer Prüfung wie eine von ihm angelegte aus.
# Rechte und Begründung: access/app-access.yaml
APP_NAMESPACE=app-dev
APP_SERVICE_ACCOUNT=app-deployer
# Wohin `make app-access` die Kubeconfig schreibt. Enthält ein gültiges Token -
# von .gitignore ausgeschlossen.
APP_KUBECONFIG=access/kubeconfig-app.yaml
