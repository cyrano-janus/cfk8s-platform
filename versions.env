# Alle Versionen an EINER Stelle. Wer eine Komponente hebt, ändert sie hier und
# nirgends sonst — die Makefile-Ziele und die Skripte in ops/ lesen von hier.

# ---------------------------------------------------------------- Cloud Foundry
# Das Upstream-Projekt, das die echten CF-Komponenten auf kind ausrollt:
# cloud_controller_ng (capi), UAA, Diego, gorouter, credhub, loggregator.
#
# Gepinnt auf einen Commit, nicht auf einen Branch. Ein Repo, das seine
# BOSH-Release-Versionen laufend nachzieht, ändert sonst unter uns die
# Plattform, gegen die wir Befunde protokollieren.
#
# Und zwar auf einen Commit, der ein **Tag** trägt: c3d6df4 ist v0.24.0. Der
# vorige Pin (ea2c0ad) lag mitten in diesem Release - derselbe Gedanke, halb
# ausgeführt, denn ein loser Commit ist nirgends beschrieben. Zu einem Tag
# gehören Release-Notes, gegen die sich ein Befund datieren lässt.
#
# Der Sprung bringt: k8s-policy-agent 0.4.0 und Calico als Alternative zu
# Cilium. Letzteres ist der Grund für den Sprung - die Ursache von FINDINGS #32
# liegt in Ciliums Prüfung gegen Endpunkt-Identitäten. Die CF-Komponenten
# ändern sich nicht (weiterhin cf-deployment v60.5.0).
CF_KIND_REPO=https://github.com/cloudfoundry/kind-deployment.git
CF_KIND_COMMIT=c3d6df4
KIND_CLUSTER_NAME=cfk8s

# Welche CNI der Upstream installiert. Er liest die Variable aus der Umgebung
# (values.yaml.gotmpl: `cni: {{ "CNI" | env | default "cilium" }}`), und das
# `export` im Makefile reicht alles aus dieser Datei an ihn weiter.
#
# Auf `calico`, weil die Ursache von FINDINGS #32 in Cilium liegt: es prueft
# eine Egress-Regel gegen die Endpunkt-Identitaet des Ziel-Pods, und eine ASG
# kennt nur CIDRs - der Weg einer App zu ihrer Datenbank ist damit durch eine
# ASG nicht zu oeffnen. Calico wertet `nets:` gegen die Zieladresse aus. Ob die
# ASG damit traegt, ist die Messung, fuer die diese Zeile steht.
#
# Zurueck auf `cilium` ist eine Zeile plus `make down cf-up`. Der Upstream
# testet beide.
CNI=calico

# Der Namespace, in dem die CF-Komponenten liegen (vom Upstream vorgegeben).
CF_SYSTEM_NAMESPACE=cf-system

# Org und Space, in denen geprüft wird.
CF_ORG=system
CF_SPACE=spike

# ---------------------------------------------------------------- Broker
BROKER_SRC=../osb-broker-go
BROKER_IMAGE=osb-broker-go:dev
BROKER_NAMESPACE=osb-broker
BROKER_FULLNAME=osb-broker
BROKER_NAME=osb-broker-go

# Welche ServiceDefinitions aus dem Broker-Repo ausgerollt werden. Die Liste
# steuert `make broker-definitions` und beide Richtungen der Katalogprüfung in
# verify/05-broker.sh.
BROKER_DEFINITIONS="cnpg-postgresql cnpg-pgvector rabbitmq-cluster"

# Der Namespace, in dem die Ressourcen der Instanzen liegen (ADR 0010). Muss
# mit config.instanceNamespaceTemplate in broker/values.cfk8s.yaml
# uebereinstimmen - `make instance-namespace` legt ihn an.
INSTANCE_NAMESPACE=osb-instances

# ---------------------------------------------------------------- Backing Services
# Wie ein Operator installiert wird, steht in services/<name>/service.env;
# WELCHE Version, steht hier.
CNPG_VERSION=1.30.0
RABBITMQ_OPERATOR_VERSION=v2.22.5

# ---------------------------------------------------------------- Werkzeuge
CERT_MANAGER_VERSION=v1.19.4
# yq braucht der Upstream fuer den Buildpack-Upload, bringt es aber nicht mit.
YQ_VERSION=v4.47.1

# ---------------------------------------------------------------- Observability
# Ein EIGENER kind-Cluster, nicht ein Namespace in cfk8s. Der Grund ist der
# Zweck: `make down` loescht die Plattform mitsamt allem, was in ihr liegt. Ein
# Beobachter, der mit dem Beobachteten stirbt, kann ueber Laeufe hinweg nichts
# aussagen - und genau das ist hier die Frage.
OBS_CLUSTER_NAME=observability
OBS_NAMESPACE=observability

# kube-prometheus-stack bringt Operator, Prometheus und Grafana aus EINER
# Quelle mit einer Version. Der Vorgaenger war handgemacht: Bundle-YAML von
# Hand angewendet, nirgends versioniert, nach einem Neuaufbau nicht
# wiederherstellbar.
KPS_VERSION=91.5.0
KPS_REPO=https://prometheus-community.github.io/helm-charts

# Feste NodePorts, damit kind sie im Wirt veroeffentlichen kann - die
# Zuordnung steht in observability/kind.yaml und muss dazu passen.
OBS_GRAFANA_NODEPORT=30300
OBS_PROMETHEUS_NODEPORT=30900

# Der Weg zum Broker im NACHBARCLUSTER: ein NodePort dort, den Prometheus hier
# abfragt. Beide kind-Cluster haengen im Docker-Netz "kind", in dem Docker die
# Knotennamen aufloest - deshalb `cfk8s-control-plane` als Ziel und nicht eine
# IP. Nach einem Neustart des Wirts vergibt Docker neue Adressen (FINDINGS
# #33), aber die Namen bleiben.
BROKER_METRICS_NODEPORT=30443

# Zwei Messfuehler auf dem WIRT, nicht im Cluster. Ein Exporter in einem
# kind-Cluster misst dessen Knoten-Container, nicht den Laptop - die Zahlen
# saehen plausibel aus und waeren falsch. Beide haengen am Docker-Netz "kind",
# damit Prometheus sie ueber ihren Namen erreicht.
#
# node-exporter liefert die Werte des Rechners (RAM, CPU, Datentraeger),
# cAdvisor die je Container - also die Antwort auf "wer verbraucht das".
NODE_EXPORTER_VERSION=v1.12.1
# NICHT die neueste Release-Nummer von GitHub: zu v0.60.6 existiert in
# gcr.io/cadvisor/cadvisor kein Image (geprueft ueber die Tag-Liste der
# Registry, nachdem `docker compose` mit "not found" abbrach). v0.55.1 ist der
# juengste tatsaechlich veroeffentlichte Stand.
CADVISOR_VERSION=v0.55.1

# ---------------------------------------------------------------- Anwendungen
# Ein DRITTER kind-Cluster, fuer Anwendungen, die Nutzern gehoeren.
#
# Nicht in cfk8s, und das ist der ganze Punkt: dort ist `make down` ein
# normaler Arbeitsschritt. Was Nutzer betreiben, darf nicht mit der
# Testplattform sterben. Cloud Foundry bleibt daneben bestehen - wer `cf push`
# will, benutzt weiter cfk8s; wer einen Namespace will, bekommt ihn hier.
APPS_CLUSTER_NAME=apps

# 80 und 443 am Wirt gehoeren bereits Cloud Foundry (cfk8s-worker, nachgesehen
# mit `docker port`). Ein zweiter Cluster kann sie nicht auch belegen.
APPS_HTTP_PORT=8080
APPS_HTTPS_PORT=8443

# Eigenes Namensschema, damit nichts mit CF verwechselt wird: dessen
# Anwendungen liegen unter *.apps.127-0-0-1.nip.io. Eine Adresse hier sieht so
# aus: http://meine-app.k8s.127-0-0-1.nip.io:8080
APPS_DOMAIN=k8s.127-0-0-1.nip.io

INGRESS_NGINX_VERSION=4.15.1
INGRESS_NGINX_REPO=https://kubernetes.github.io/ingress-nginx
# Der Datenbank-Operator ist derselbe wie auf der Plattform - eine Version fuer
# beide Cluster, damit ein Befund von dort hier gilt und umgekehrt.

# Objektzustaende je Namespace - wie viele Pods ein Mandant betreibt, ob seine
# Deployments bereit sind. Der Ingress-Controller und der kubelet liefern das
# nicht; sie kennen Anfragen und Ressourcen, nicht die Absicht dahinter.
KUBE_STATE_METRICS_VERSION=8.5.0

# Feste Knotenports, ueber die der Observability-Cluster hereinschaut. Der
# kubelet braucht keinen: er lauscht ohnehin auf 10250 am Knoten, und beide
# Cluster haengen im selben Docker-Netz.
APPS_INGRESS_METRICS_NODEPORT=30254
APPS_KSM_NODEPORT=30808

# ---------------------------------------------------------------- Geheimnisse
# OpenBao im Anwendungs-Cluster, NICHT in cfk8s und nicht in observability.
# Grund: OpenBaos Kubernetes-Anmeldung prueft ServiceAccount-Tokens ueber die
# TokenReview-API SEINES EIGENEN Clusters. Stuende der Speicher woanders,
# braeuchte er einen Zugang ueber die Clustergrenze - ein Netzweg und ein
# Geheimnis mehr, fuer nichts.
#
# Fuer Cloud Foundry gilt das NICHT: dort traegt CredHub die
# Service-Credentials, und der Cloud Controller ist damit verbunden
# (credential_references.interpolate_service_bindings: true). CF-Anwendungen
# brauchen OpenBao nicht - die Begruendung steht in apps/GEHEIMNISSE.md.
OPENBAO_NAMESPACE=openbao
# Unter dieser Adresse erreichen die Mandanten den Speicher von aussen - ohne
# sie koennte nur der Betreiber schreiben, und der waere bei zehn Mandanten mit
# je einem Dutzend Schluesseln der Flaschenhals fuer eine Taetigkeit, die ihn
# nichts angeht. Dass er dabei fremde Geheimnisse zu sehen bekaeme, ist der
# zweite Grund.
OPENBAO_HOST=openbao.k8s.127-0-0-1.nip.io
OPENBAO_REPO=https://openbao.github.io/openbao-helm
# Die 0.29-Linie wird bewusst nicht verlassen: Chart 0.30.0 wechselt den
# Standalone-Speicher auf PebbleDB und verlangt eine Migration VON HAND
# (openbao.org/docs/guides/migrations/k8s-pebbledb). Unser Speicher laeuft auf
# `storage "file"` (apps/openbao-values.yaml) - ein Sprung auf 0.30.x ohne
# diese Migration faende die abgelegten Geheimnisse nicht wieder.
OPENBAO_CHART_VERSION=0.29.6

# Die Programmversion getrennt vom Chart. Das ist die einzige Stelle im Repo,
# an der eine Version nicht aus ihrem Chart kommt, und sie braucht deshalb
# einen Grund: 2.6.4 schliesst fuenf Luecken, aber KEIN Chart traegt sie. Die
# 0.29-Linie endet bei appVersion 2.6.3, danach springt das Chart auf 0.30.x
# mitsamt dem Speicherbruch. Ohne diesen Override bliebe nur die Wahl zwischen
# einer Datenmigration und drei offenen Luecken.
#
# Was 2.6.4 schliesst, 2.6.2 aber offen hatte:
#   CVE-2026-104092  (hoch)    PKI-ACME stellt Zertifikate mit ungeprueften
#                              SANs aus
#   GHSA-gf3j-hm38-jhh5        die Kubernetes-Anmeldung erlaubt das Erneuern
#                              widerrufener Tokens - genau das Verfahren, auf
#                              dem dieses Verzeichnis aufbaut
#   GHSA-5v22-543h-wg96        rollenbasierte Rate-Limits sind umgehbar
#   GHSA-8xxq-mq9m-xmhw        Plugins geben fehlerhafte Parameter preis
#   GHSA-q74w-hv5x-6hxf        Root-Token-Erzeugung wird nicht protokolliert
#
# Diese Zeile faellt weg, sobald ein Chart wieder eine Version traegt, die neu
# genug ist - der Override ist die Ausnahme, nicht der neue Weg.
OPENBAO_VERSION=2.6.4

# Der External Secrets Operator holt Werte aus OpenBao und legt sie als
# Kubernetes-Secret ab. Er ist das Stueck, das GitOps ueberhaupt erst
# ertraeglich macht: in Git steht nur eine Referenz, nie ein Wert.
ESO_REPO=https://charts.external-secrets.io
ESO_CHART_VERSION=2.11.0

# Die Entsiegelungsschluessel aus der einmaligen Initialisierung. Wer diese
# Datei hat, hat den Speicher - deshalb 600 und von .gitignore ausgeschlossen.
# Dass sie auf demselben Rechner liegt wie OpenBao, ist der Grund, warum hier
# nichts geschuetzt ist: geuebt wird der Umgang, nicht der Schutz.
OPENBAO_INIT_FILE=apps/openbao-init.local.json
