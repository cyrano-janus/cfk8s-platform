# CloudNativePG — PostgreSQL-Operator.
#
# Version steht in versions.env (CNPG_VERSION), nicht hier: dieses Verzeichnis
# beschreibt, WIE der Operator installiert wird, versions.env WELCHE Version.
# Die Datei wird von `make services` mit `set -a; . service.env` gelesen, die
# ${...}-Ausdrücke expandiert also die Shell gegen die Umgebung aus versions.env.
#
# Die URL trägt die Version zweimal in verschiedener Form: der Release-Branch
# heißt nur nach Major.Minor (release-1.30), die Datei nach der vollen Version
# (cnpg-1.30.0.yaml). ${CNPG_VERSION%.*} schneidet dafür den Patch ab.
NAME="CloudNativePG"
VERSION="${CNPG_VERSION}"
URL="https://raw.githubusercontent.com/cloudnative-pg/cloudnative-pg/release-${CNPG_VERSION%.*}/releases/cnpg-${CNPG_VERSION}.yaml"
WAIT_NS="cnpg-system"
WAIT_DEPLOY="cnpg-controller-manager"

# Welche ServiceDefinition aus dem Broker-Repo diesen Operator nutzt, und welche
# CRDs der Broker dafür anfassen muss. Beides zur Dokumentation an einer Stelle —
# eingetragen wird es in versions.env (BROKER_DEFINITIONS) und in
# broker/values.korifi.yaml (rbac.operatorCRDs).
DEFINITION="cnpg-postgresql"
CRD_GROUP="postgresql.cnpg.io"
CRD_RESOURCES="clusters"
